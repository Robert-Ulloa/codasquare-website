# Environment Variables
# Copy this to .env.local and fill in values as needed

# Site URL (for production)
NEXT_PUBLIC_SITE_URL=https://codasquare.com

# Formspree — get your form ID at https://formspree.io
# Create a form, copy the ID (e.g., "xyzabcde"), and paste it here
NEXT_PUBLIC_FORMSPREE_ID=

# Google Analytics 4 — get your measurement ID at https://analytics.google.com
# Create a GA4 property, copy the measurement ID (e.g., "G-XXXXXXXXXX"), and paste it here
NEXT_PUBLIC_GA_MEASUREMENT_ID=
